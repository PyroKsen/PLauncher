{
  "dependencies": {
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.1",
    "unzipper": "^0.12.3"
  },
  "name": "plauncher",
  "version": "1.0.6",
  "description": "Game launcher for PLauncher",
  "main": "main.js",
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.8.1"
  },
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.pyroksen.plauncher",
    "productName": "PLauncher",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "**/*",
      "!dist/**",
      "!Plauncher/**",
      "!*.zip",
      "!.git/**",
      "!.vscode/**",
      "!tt.txt",
      "!Barotrauma/**",
      "!LethalCompany/**",
      "!Slay The Spire 2/**",
      "!Casualties Unknown/**",
      "!CasualtiesUnknown/**",
      "!Risk of Rain 2/**",
      "!RiskOfRain2/**",
      "!.plauncher-download-*",
      "!versions.json.tmp"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PyroKsen",
        "repo": "PLauncher",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/иконка-лаунчер.ico",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PLauncher",
      "uninstallDisplayName": "PLauncher",
      "installerIcon": "assets/images/иконка-лаунчер.ico",
      "uninstallerIcon": "assets/images/иконка-лаунчер.ico",
      "installerHeaderIcon": "assets/images/иконка-лаунчер.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyroKsen/PLauncher.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PyroKsen/PLauncher/issues"
  },
  "homepage": "https://github.com/PyroKsen/PLauncher#readme"
}
