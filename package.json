{
  "dependencies": {
    "fs-extra": "^11.3.1",
    "unzipper": "^0.12.3"
  },
  "name": "plauncher",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.8.1"
  },
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --win portable"
  },
  "build": {
    "artifactName": "plauncher.${ext}",
    "files": [
      "**/*",
      "!dist/**",
      "!Plauncher/**",
      "!*.zip",
      "!.git/**",
      "!.vscode/**",
      "!Barotrauma/**",
      "!LethalCompany/**",
      "!Slay The Spire 2/**",
      "!.plauncher-download-*",
      "!versions.json.tmp"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/images/иконка-лаунчер.ico",
      "signAndEditExecutable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyroKsen/PLauncher.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PyroKsen/PLauncher/issues"
  },
  "homepage": "https://github.com/PyroKsen/PLauncher#readme"
}
